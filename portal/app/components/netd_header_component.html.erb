<header class="netd-header" role="banner">
  <div class="netd-groupbar">
    <div class="container"><% if (dev = Netd.credit('developed by')) %><a href="<%= dev['url'] %>" target="_blank" rel="noopener"><%= dev['name'] %></a><% end %></div>
  </div>
  <div class="container netd-masthead">
    <a class="netd-wordmark" href="<%= helpers.root_path %>">
      <span class="netd-wm-a"><%= Netd.wordmark[0] %></span><span class="netd-wm-sep"></span><span class="netd-wm-b"><%= Netd.wordmark[1] %></span>
    </a>
    <form class="netd-search" action="<%= helpers.search_action_url %>" method="get" role="search">
      <input type="hidden" name="search_field" value="all_fields">
      <label for="netd-q" class="visually-hidden"><%= helpers.nt('header.search') %></label>
      <input id="netd-q" type="search" name="q" value="<%= helpers.params[:q] %>" placeholder="<%= helpers.nt('header.search_placeholder') %>">
      <button type="submit" aria-label="<%= helpers.nt('header.search') %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
      </button>
    </form>
  </div>
  <nav class="netd-navrow" aria-label="<%= helpers.nt('header.nav_label') %>">
    <div class="container">
      <a href="<%= helpers.about_path %>"><%= helpers.nt('header.about_html') %></a>
      <a href="<%= helpers.search_action_path(q: '', search_field: 'all_fields') %>"><%= helpers.nt('header.explore_html') %></a>
      <a href="<%= helpers.browse_path %>"><%= helpers.nt('header.browse_html') %></a>
    </div>
  </nav>
</header>
