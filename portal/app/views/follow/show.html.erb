<% content_for(:page_title) { nt('follow.page_title') } %>
<div class="netd-page netd-faq">
  <h1><%= nt('follow.heading_html') %></h1>
  <p><%= nt('follow.be_told_when_new_html') %></p>
  <table class="netd-about netd-api">
    <tr><th><%= nt('follow.search_html') %></th><td><%= @query['q'].presence ? "“#{@query['q']}”" : 'All theses and dissertations' %>
      <% if @filters.any? %><br><%= @filters.join(' · ') %><% end %>
      <br><%= link_to 'See the newest matches', @results %></td></tr>
    <tr><th><%= nt('follow.atom_feed_html') %></th><td><code class="netd-feed-url"><%= @atom %></code></td></tr>
    <tr><th><%= nt('follow.rss_feed_html') %></th><td><code class="netd-feed-url"><%= @rss %></code></td></tr>
  </table>

  <h2><%= nt('follow.in_a_feed_reader_html') %></h2>
  <p><%= nt('follow.copy_one_of_the_html') %></p>

  <h2><%= nt('follow.by_email_html') %></h2>
  <p><%= nt('follow.feed_to_email_services_html') %></p>

  <h2><%= nt('follow.other_ways_to_follow_html') %></h2>
  <ul>
    <li><%= nt('follow.everything_newly_added_html', link1: link_to(nt('follow.everything_newly_added_link1'), search_action_path(sort: 'added')), link2: link_to(nt('follow.everything_newly_added_link2'), search_action_url(sort: 'added', per_page: 20, format: 'atom')), link3: link_to(nt('follow.everything_newly_added_link3'), search_action_url(sort: 'added', per_page: 20, format: 'rss'))) %></li>
    <li><%= nt('follow.developers_can_use_the_html', link1: link_to(nt('follow.developers_can_use_the_link1'), developers_path)) %></li>
  </ul>
</div>
