<% p = @data['project'] %>
<% content_for(:page_title) { nt('about.page_title', name: p['name']) } %>
<div class="netd-page">
  <h1 class="h3"><%= nt('about.heading_html', name: p['name']) %></h1>
  <p><%= p['summary'] %></p>
  <div class="netd-partner-logos">
<% Netd.credits.each do |c| %>    <a href="<%= c['url'] %>" class="<%= c['class'] %>" title="<%= Netd.credit_title(c) %>" target="_blank" rel="noopener"><% if Netd.credit_logo(c) %><img src="/images/<%= c['logo'] %>" alt="<%= Netd.credit_alt(c) %>" height="<%= c['logo_height'] %>"><% else %><span class="netd-credit-name"><%= c['name'] %></span><% end %></a>
<% end %>  </div>
<% dev = Netd.credit('developed by'); host = Netd.credit('hosted by') %>  <p><% if dev %><%= nt('about.developed_by_html') %> <%= "#{dev['article']} " if dev['article'] %><%= link_to dev['name'], dev['url'], target: '_blank', rel: 'noopener' %><% end %><% if host %><%= nt('about.hosted_by_html') %>
    <%= link_to host['name'], host['url'], target: '_blank', rel: 'noopener' %><%= " (#{host['full_name']})" if host['full_name'] %><%= nt('about.hosted_role_html') %><% end %>
    <%= nt('about.see_credits_html', link: link_to(nt('about.see_credits_link'), credits_path)) %>
    <%= nt('about.project_page_html', link: link_to(p['url'], p['url'], target: '_blank', rel: 'noopener')) %></p>
  <h2 class="h5 mt-4"><%= nt('about.project_members_html') %></h2>
  <ul class="netd-members">
    <% p['members'].each do |m| %><li><strong><%= m['url'] ? link_to(m['name'], m['url'], target: '_blank', rel: 'noopener') : m['name'] %></strong> (<%= m['role'] %>)</li><% end %>
  </ul>
  <h2 class="h5 mt-4"><%= nt('about.publications_based_on_the_html', link1: link_to(nt('about.publications_based_on_the_link1'), p['url'], target: '_blank', rel: 'noopener')) %></h2>
  <p><%= nt('about.the_publications_dissertations_and_html', link1: link_to(nt('about.the_publications_dissertations_and_link1'), p['url'], target: '_blank', rel: 'noopener')) %></p>
  <ul class="netd-pubs">
    <% @data['publications'].each do |x| %>
      <li><span class="etd-badge etd-badge-year"><%= x['year'] %></span> <span class="etd-badge etd-badge-level"><%= x['type'] %></span><br>
        <%= x['authors'] %> (<%= x['year'] %>). <em><%= x['title'] %></em>. <%= x['venue'] %>.
        <%= link_to x['url'], x['url'], target: '_blank', rel: 'noopener' %></li>
    <% end %>
  </ul>
  <p class="mt-3"><%= link_to nt('common.back_to_search'), root_path %></p>
</div>
