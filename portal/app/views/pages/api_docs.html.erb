<% content_for(:page_title) { nt('api_docs.page_title') } %>
<% content_for(:head) do %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui.css" crossorigin="anonymous">
<% end %>
<div class="netd-page">
  <h1><%= nt('api_docs.heading_html') %></h1>
  <p><%= nt('api_docs.version_of_the_portal_html', link1: link_to(nt('api_docs.version_of_the_portal_link1'), '/api/v1/openapi.yaml'), link2: link_to(nt('api_docs.version_of_the_portal_link2'), developers_path)) %></p>
  <div id="swagger-ui"><p><%= nt('api_docs.loading_the_reference_if_html', link1: link_to(nt('api_docs.loading_the_reference_if_link1'), '/api/v1/openapi.yaml')) %></p></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui-bundle.js" crossorigin="anonymous"></script>
<script>
  window.addEventListener('load', function () {
    if (!window.SwaggerUIBundle) return;
    window.SwaggerUIBundle({ url: '/api/v1/openapi.yaml', dom_id: '#swagger-ui', deepLinking: true,
      defaultModelsExpandDepth: 0, docExpansion: 'list', tryItOutEnabled: true });
  });
</script>
