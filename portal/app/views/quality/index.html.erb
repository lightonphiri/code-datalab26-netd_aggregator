<% content_for(:page_title) { nt('quality.page_title') } %>
<div class="netd-page netd-faq netd-quality">
  <h1><%= nt('quality.heading_html') %></h1>
  <p><%= nt('quality.how_complete_the_metadata_html') %></p>
  <% if @report.nil? || @report['institutions'].empty? %>
    <p class="netd-note"><%= nt('quality.the_quality_report_has_html') %></p>
  <% else %>
    <% all = @report['institutions'].first %>
    <%= render 'quality/legend' %>
    <table class="netd-stats netd-qheadline">
      <tr><td><%= all['etdms_compliance'] %>%</td><td><%= nt('quality.etd_ms_compliance_at_html') %></td></tr>
      <tr><td><%= all['complete_after_portal'] %>%</td><td><%= nt('quality.complete_in_the_portal_html') %></td></tr>
      <tr><td><%= number_with_delimiter(all['records']) %></td><td><%= nt('quality.etds_from_html', n: @report['institutions_measured']) %></td></tr>
    </table>

    <h2><%= nt('quality.by_element_html') %></h2>
    <p><%= nt('quality.share_of_all_etds_html') %></p>
    <table class="netd-about netd-api netd-qtable">
      <thead><tr><th><%= nt('quality.element_etd_ms_html') %></th><th><%= nt('quality.origin_of_the_value_html') %></th>
        <% QualityReport::GROUPS.each_value do |(l, _)| %><th class="text-end"><%= l %></th><% end %></tr></thead>
      <tbody>
      <% all['elements'].each do |e| %>
        <tr><td><%= e['label'] %><% if e['etdms'] %><br><small><code><%= e['etdms'] %></code></small><% end %></td>
          <td><%= quality_bar(e, e['label'], compact: false) %></td>
          <% QualityReport::GROUPS.each_key do |g| %><td class="text-end"><%= e[g] %>%</td><% end %></tr>
      <% end %>
      </tbody>
    </table>

    <h2><%= nt('quality.about_these_figures_html') %></h2>
    <ul>
      <li><%= nt('quality.computed_html', time: Time.parse(@report['generated_at']).in_time_zone(Netd.time_zone).strftime('%B %-d, %Y, %H:%M'), zone: Netd.time_zone_label,
        csv: link_to('CSV', quality_path(format: :csv)), json: link_to('JSON', quality_path(format: :json))) %></li>
      <li><%= nt('quality.at_source_counts_only_html') %></li>
      <li><%= nt('quality.institutions_that_want_to_html', link1: link_to(nt('quality.institutions_that_want_to_link1'), contribute_path)) %></li>
    </ul>
  <% end %>
</div>
