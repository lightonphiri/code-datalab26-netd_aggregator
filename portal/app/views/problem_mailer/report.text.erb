<%# Text in en.yml under netd.mail.problem (P4f); plain text, so nothing is escaped %>
<%= t('netd.mail.problem.intro', portal: Netd.portal_name) %>

<%= t('netd.mail.problem.problem', value: @r.problem) %>
<%= t('netd.mail.problem.record', value: @r.record_title) %>
<%= t('netd.mail.problem.url', value: @r.record_url) %>
<%= t('netd.mail.problem.from', name: @r.name.presence || t('netd.mail.problem.anonymous'), email: @r.email) %>
<%= t('netd.mail.problem.sent', value: (l(@r.created_at, format: :netd_mail) if @r.created_at)) %>

<%= t('netd.mail.problem.message') %>
<%= @r.message %>

<%= t('netd.mail.problem.footer', n: @r.id) %>
