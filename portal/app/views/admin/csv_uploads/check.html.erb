<% content_for(:page_title) { 'Check CSV · Admin' } %>
<div class="netd-admin">
  <%= render 'admin/nav' %>
  <h1>Check: <%= @filename %></h1>
  <p>For <strong><%= @target[:name] %></strong> (<%= @target[:short_name] %>)<%= ', a new CSV source' if @target[:new] %>.</p>
  <p><%= number_with_delimiter(@rows) %> rows: <strong><%= number_with_delimiter(@valid) %> valid</strong>,
    <%= number_with_delimiter(@bad) %> with problems<%= ' (these rows will be skipped)' if @bad.positive? && @valid.positive? %>.</p>
  <pre class="netd-code netd-admin-log"><%= @output %></pre>
  <% if @valid.positive? %>
    <%= form_with url: admin_load_csv_path do |f| %>
      <%= f.hidden_field :token, value: @token %>
      <%= f.hidden_field :filename, value: @filename %>
      <% if @target[:new] %>
        <%= f.hidden_field :institution, value: @target[:name] %><%= f.hidden_field :short_name, value: @target[:short_name] %>
      <% else %>
        <%= f.hidden_field :source_id, value: @target[:id] %>
      <% end %>
      <%= f.submit "Load #{number_with_delimiter(@valid)} records", class: 'btn btn-primary',
                   data: { turbo_confirm: "Replace #{@target[:name]}'s records with this file?" } %>
      <%= link_to 'Cancel', new_admin_csv_upload_path, class: 'btn btn-link' %>
    <% end %>
  <% else %>
    <div class="alert alert-danger">This file has no valid rows and cannot be loaded. Send the problems above to the institution.</div>
    <%= link_to 'Upload another file', new_admin_csv_upload_path, class: 'btn btn-outline-primary' %>
  <% end %>
</div>
