<% content_for(:page_title) { nt('admin.csv.check_page_title') } %>
<div class="netd-admin">
  <%= render 'admin/nav' %>
  <h1><%= nt('admin.csv.check_heading_html', name: @filename) %></h1>
  <p><%= nt(@target[:new] ? 'admin.csv.for_new_html' : 'admin.csv.for_html', name: @target[:name], short: @target[:short_name]) %></p>
  <p><%= nt(@bad.positive? && @valid.positive? ? 'admin.csv.rows_skipped_html' : 'admin.csv.rows_html', rows: number_with_delimiter(@rows), valid: number_with_delimiter(@valid), bad: number_with_delimiter(@bad)) %></p>
  <pre class="netd-code netd-admin-log"><%= @output %></pre>
  <% if @valid.positive? %>
    <%= form_with url: admin_load_csv_path do |f| %>
      <%= f.hidden_field :token, value: @token %>
      <%= f.hidden_field :filename, value: @filename %>
      <% if @target[:new] %>
        <%= f.hidden_field :institution, value: @target[:name] %><%= f.hidden_field :short_name, value: @target[:short_name] %>
      <% else %>
        <%= f.hidden_field :source_id, value: @target[:id] %>
      <% end %>
      <%= f.submit nt('admin.csv.load', n: number_with_delimiter(@valid)), class: 'btn btn-primary',
                   data: { turbo_confirm: nt('admin.csv.confirm', name: @target[:name]) } %>
      <%= link_to nt('admin.csv.cancel'), new_admin_csv_upload_path, class: 'btn btn-link' %>
    <% end %>
  <% else %>
    <div class="alert alert-danger"><%= nt('admin.csv.no_valid_html') %></div>
    <%= link_to nt('admin.csv.another'), new_admin_csv_upload_path, class: 'btn btn-outline-primary' %>
  <% end %>
</div>
