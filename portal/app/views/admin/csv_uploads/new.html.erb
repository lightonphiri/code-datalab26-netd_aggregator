<% content_for(:page_title) { nt('admin.csv.page_title') } %>
<div class="netd-admin">
  <%= render 'admin/nav' %>
  <h1><%= nt('admin.csv.heading_html') %></h1>
  <p><%= nt('admin.csv.intro_html', link1: link_to(nt('admin.csv.intro_link1'), '/netd-etd-template.csv'), link2: link_to(nt('admin.csv.intro_link2'), developers_path)) %></p>
  <%= form_with url: admin_csv_uploads_path, multipart: true do |f| %>
    <div class="mb-3">
      <%= f.label :source_id, nt('admin.csv.existing'), class: 'form-label' %>
      <%= f.select :source_id, options_for_select(@csv_sources.map { |s| [s['name'], s['id']] }, params[:source_id]),
                   { include_blank: @csv_sources.any? ? nt('admin.csv.none_new') : nt('admin.csv.none_yet') }, class: 'form-select' %>
    </div>
    <fieldset class="mb-3 netd-admin-box">
      <legend><%= nt('admin.csv.or_new_html') %></legend>
      <div class="row g-2">
        <div class="col-md-8"><%= f.label :institution, nt('admin.csv.institution'), class: 'form-label' %>
          <%= f.select :institution, options_for_select(@new_institutions), { include_blank: nt('admin.csv.choose') }, class: 'form-select' %></div>
        <div class="col-md-4"><%= f.label :short_name, nt('admin.csv.short_name'), class: 'form-label' %>
          <%= f.text_field :short_name, maxlength: 16, class: 'form-control' %></div>
      </div>
    </fieldset>
    <div class="mb-3"><%= f.label :file, nt('admin.csv.file'), class: 'form-label' %>
      <%= f.file_field :file, accept: '.csv,text/csv', required: true, class: 'form-control' %></div>
    <%= f.submit nt('admin.csv.check'), class: 'btn btn-primary' %>
  <% end %>
</div>
