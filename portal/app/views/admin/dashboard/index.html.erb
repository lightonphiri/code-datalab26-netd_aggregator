<% content_for(:page_title) { 'Dashboard · Admin' } %>
<div class="netd-admin">
  <%= render 'admin/nav' %>
  <h1>Dashboard</h1>
  <% if @status[:error] %><div class="alert alert-danger">Staging store not readable: <%= @status[:error] %></div><% end %>
  <p>
    <%= @running ? tag.span('A harvest is running now', class: 'badge text-bg-warning') : tag.span('No harvest running', class: 'badge text-bg-light') %>
    · Records in the search index: <strong><%= number_with_delimiter(@indexed.values.sum) %></strong>
    · <%= link_to pluralize(@open_reports, 'open problem report'), admin_problem_reports_path %>
  </p>
  <h2>Sources</h2>
  <table class="table table-sm netd-admin-table">
    <thead><tr><th>Source</th><th>Loader</th><th>Last harvest</th><th>Status</th><th class="text-end">In store</th><th class="text-end">Indexed</th><th></th></tr></thead>
    <tbody>
    <% @sources.each do |s| run = @status[:runs][s['id']] %>
      <tr>
        <td><%= link_to s['name'], admin_source_path(s['id']) %> <small class="text-muted"><%= s['short_name'] %></small></td>
        <td><%= s['loader'] || 'oai-pmh' %></td>
        <td><%= admin_time(run && run['started_at']) %></td>
        <td><%= run_badge(run && run['status']) %> <small class="text-muted"><%= run && run['message'].to_s.truncate(80) %></small></td>
        <td class="text-end"><%= number_with_delimiter(@status[:counts][s['id']] || 0) %></td>
        <td class="text-end"><%= number_with_delimiter(@indexed[s['id']] || 0) %></td>
        <td class="text-end"><%= button_to 'Run now', admin_run_source_path(s['id']), class: 'btn btn-sm btn-outline-primary', disabled: @running,
                                 form: { data: { turbo_confirm: "Harvest #{s['name']} now?" } } %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <p class="netd-admin-help">The nightly harvest of all sources runs at 04:30 (Lusaka time). "Run now" harvests one source;
    only one harvest runs at a time.</p>
  <h2>Institutions not yet harvested</h2>
  <% if @repo_check %>
    <p class="netd-admin-help">Weekly check of the repositories in <code>harvester/institutions.yml</code> (FR-58), last run
      <%= admin_time(Time.parse(@repo_check['checked_at']).to_i) rescue @repo_check['checked_at'] %>.
      <% if @repo_check['changes'].present? %><strong>Changes since the previous check:</strong> <%= @repo_check['changes'].join('; ') %><% end %></p>
    <table class="table table-sm netd-admin-table">
      <thead><tr><th>Institution</th><th>Registry status</th><th>Repository</th><th>Reachable</th><th class="text-end">OAI-PMH records</th><th class="text-end">In ETD sets</th></tr></thead>
      <tbody>
      <% @repo_check['repositories'].each do |r| %>
        <tr>
          <td><%= r['name'] %></td>
          <td><%= InstitutionRegistry::STATUS_LABELS[r['status']] || r['status'] %></td>
          <td><%= link_to (r['repository'] || r['oai']).to_s.truncate(50), r['repository'] || r['oai'], target: '_blank', rel: 'noopener' %></td>
          <td><%= r['reachable'] ? tag.span('yes', class: 'badge text-bg-success') : tag.span('no', class: 'badge text-bg-danger') %></td>
          <td class="text-end"><%= r['records'] || '–' %></td>
          <td class="text-end"><%= r['etd_sets'].present? ? (r['etd_records'] || '–') : '' %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="netd-admin-help">No repository check yet (<code>netd.cli check-repositories</code> runs weekly).</p>
  <% end %>
  <p class="netd-admin-help">Institutions without a repository can contribute by CSV (Upload CSV) — see the
    <%= link_to 'guide for institutions', contribute_path %>.</p>
  <h2>Recent activity</h2>
  <%= render 'admin/events/table', events: @events %>
  <p><%= link_to 'Full activity log', admin_events_path %></p>
</div>
