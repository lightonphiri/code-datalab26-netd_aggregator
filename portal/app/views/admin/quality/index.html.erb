<% content_for(:page_title) { nt('admin.quality.page_title') } %>
<% groups = QualityReport::GROUPS %>
<div class="netd-admin netd-quality">
  <%= render 'admin/nav' %>
  <h1><%= nt('admin.quality.heading_html') %></h1>
  <p class="netd-admin-help"><%= nt('admin.quality.help_html', link: link_to(nt('admin.quality.public_link'), quality_path)) %></p>
  <% if @report.nil? %>
    <p><%= nt('admin.quality.no_report_html') %></p>
  <% else %>
    <% all = @report['institutions'].find { |i| i['id'].nil? } %>
    <% insts = @report['institutions'].reject { |i| i['id'].nil? } %>
    <%= render 'quality/legend' %>
    <h2><%= nt('admin.quality.summary_html') %></h2>
    <table class="table table-sm netd-admin-table netd-qtable">
      <thead><tr><th><%= nt('admin.quality.institution_html') %></th><th class="text-end"><%= nt('admin.quality.etds_html') %></th>
        <th class="text-end" title="<%= nt('admin.quality.compliance_title_html') %>"><%= nt('admin.quality.compliance_html') %></th>
        <th class="text-end" title="<%= nt('admin.quality.complete_title_html') %>"><%= nt('admin.quality.complete_html') %></th>
        <th><%= nt('admin.quality.all_elements_html') %></th></tr></thead>
      <tbody>
      <% (insts + [all]).compact.each do |i| %>
        <tr class="<%= 'netd-qtotal' if i['id'].nil? %>">
          <td><%= i['id'] ? link_to(i['name'], "#q-#{i['id']}") : i['name'] %></td>
          <td class="text-end"><%= number_with_delimiter(i['records']) %></td>
          <td class="text-end"><strong><%= i['etdms_compliance'] %>%</strong></td>
          <td class="text-end"><%= i['complete_after_portal'] %>%</td>
          <td><%= quality_bar(quality_totals(i), i['name']) %></td>
        </tr>
      <% end %>
      </tbody>
    </table>

    <h2><%= nt('admin.quality.by_element_html') %></h2>
    <table class="table table-sm netd-admin-table netd-qtable netd-qmatrix">
      <thead><tr><th><%= nt('admin.quality.element_etdms_html') %></th><% insts.each do |i| %><th><%= i['name'] %></th><% end %></tr></thead>
      <tbody>
      <% insts.first['elements'].each_with_index do |e0, k| %>
        <tr><td><%= e0['label'] %><% if e0['etdms'] %><br><small><code><%= e0['etdms'] %></code></small><% end %></td>
          <% insts.each do |i| e = i['elements'][k] %>
            <td><%= quality_bar(e, "#{i['name']}, #{e['label']}") %>
              <small class="netd-qnum"><%= nt('admin.quality.cell_html', source: e['repository'], filled: (100 - e['missing']).round(1)) %></small></td>
          <% end %></tr>
      <% end %>
      </tbody>
    </table>

    <% insts.each do |i| %>
      <h2 id="q-<%= i['id'] %>"><%= i['name'] %></h2>
      <p><%= nt('admin.quality.inst_summary_html', n: number_with_delimiter(i['records']), compliance: i['etdms_compliance'], complete: i['complete_after_portal'], link: link_to(nt('admin.quality.source_page'), admin_source_path(i['id']))) %></p>
      <% if i['to_improve'].present? %>
        <p class="mb-1"><%= nt('admin.quality.improve_html') %></p>
        <ul><% i['to_improve'].each do |a| %><li><%= a %></li><% end %></ul>
      <% end %>
      <details>
        <summary><%= nt('admin.quality.figures_html') %></summary>
        <table class="table table-sm netd-admin-table netd-qtable">
          <thead><tr><th><%= nt('admin.quality.element_html') %></th><% groups.each_value do |(l, _)| %><th class="text-end"><%= l %></th><% end %></tr></thead>
          <tbody><% i['elements'].each do |e| %>
            <tr><td><%= e['label'] %></td><% groups.each_key do |g| %><td class="text-end"><%= e[g] %>%</td><% end %></tr>
          <% end %></tbody>
        </table>
      </details>
    <% end %>
    <p class="netd-admin-help"><%= nt('admin.quality.computed_html', time: l(Time.parse(@report['generated_at']).in_time_zone(Netd.time_zone), format: :netd), tz: Netd.time_zone_label) %>
      <%= nt('admin.quality.download_html') %> <%= link_to 'CSV', admin_quality_path(format: :csv) %> · <%= link_to 'JSON', admin_quality_path(format: :json) %>.</p>
  <% end %>
</div>
