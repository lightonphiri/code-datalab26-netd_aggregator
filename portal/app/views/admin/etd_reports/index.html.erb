<% content_for(:page_title) { nt('admin.reports.page_title') } %>
<div class="netd-admin netd-reports">
  <%= render 'admin/nav' %>
  <h1><%= nt('admin.reports.heading_html') %></h1>
  <p class="netd-admin-help"><%= nt('admin.reports.intro_html') %></p>

  <div class="row g-4">
    <div class="col-xl-6">
      <div class="card"><div class="card-body">
        <h2 class="h5"><%= nt('admin.reports.per_institution_html') %></h2>
        <p class="small text-muted"><%= nt('admin.reports.per_institution_help_html') %></p>
        <%= form_with url: admin_etd_report_path('institution'), method: :get, local: true do %>
          <%= render 'admin/etd_reports/filters', id: 'i' %>
          <div class="form-check mt-2"><%= check_box_tag :usage, '1', false, class: 'form-check-input', id: 'usage-i' %>
            <label class="form-check-label small" for="usage-i"><%= nt('admin.reports.usage_html') %></label></div>
          <%= render 'admin/etd_reports/buttons', kind: 'institution' %>
        <% end %>
      </div></div>
    </div>

    <div class="col-xl-6">
      <div class="card"><div class="card-body">
        <h2 class="h5"><%= nt('admin.reports.by_supervisor_html') %></h2>
        <p class="small text-muted"><%= nt('admin.reports.by_supervisor_help_html') %></p>
        <%= form_with url: admin_etd_report_path('supervisors'), method: :get, local: true do %>
          <%= render 'admin/etd_reports/filters', id: 's' %>
          <div class="row g-2 mt-0"><div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.supervisor') %>
            <%= text_field_tag :supervisor, nil, class: 'form-control form-control-sm', placeholder: nt('admin.reports.supervisor_example') %></label></div>
            <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.list') %>
              <%= select_tag :list, options_for_select([[nt('admin.reports.include'), '1'], [nt('admin.reports.leave_out'), '0']]), class: 'form-select form-select-sm' %></label></div></div>
          <%= render 'admin/etd_reports/buttons', kind: 'supervisors' %>
        <% end %>
      </div></div>
    </div>

    <div class="col-12">
      <div class="card"><div class="card-body">
        <h2 class="h5"><%= nt('admin.reports.custom_html') %></h2>
        <p class="small text-muted"><%= nt('admin.reports.custom_help_html') %></p>
        <%= form_with url: admin_etd_report_path('custom'), method: :get, local: true do %>
          <div class="row g-4">
            <div class="col-lg-6">
              <h3 class="h6"><%= nt('admin.reports.filters_html') %></h3>
              <%= render 'admin/etd_reports/filters', id: 'c', more: true %>
            </div>
            <div class="col-lg-6">
              <h3 class="h6"><%= nt('admin.reports.grouping_html') %></h3>
              <% groups = [[nt('admin.reports.none'), '']] + HeaReport::GROUPS.map { |k, (label, _)| [label, k] } %>
              <div class="row g-2">
                <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.group_by') %>
                  <%= select_tag :group, options_for_select(groups, 'year'), class: 'form-select form-select-sm' %></label></div>
                <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.then_by') %>
                  <%= select_tag :then_by, options_for_select(groups, 'degree_level'), class: 'form-select form-select-sm' %></label></div>
                <div class="col-12"><label class="form-label small"><%= nt('admin.reports.report_title') %>
                  <%= text_field_tag :report_title, nil, class: 'form-control form-control-sm', placeholder: nt('admin.reports.title_example'), maxlength: 120 %></label></div>
              </div>
              <h3 class="h6 mt-3"><%= nt('admin.reports.theses_html') %></h3>
              <div class="form-check"><%= check_box_tag :list, '1', true, class: 'form-check-input', id: 'list-c' %>
                <label class="form-check-label small" for="list-c"><%= nt('admin.reports.include_list_html', n: number_with_delimiter(HeaReport::LIST_MAX)) %></label></div>
              <div class="d-flex flex-wrap gap-3 mt-1">
                <% HeaReport::COLUMNS.each do |key, label| %>
                  <div class="form-check"><%= check_box_tag 'columns[]', key, HeaReport::DEFAULT_COLUMNS.include?(key), class: 'form-check-input', id: "col-#{key}" %>
                    <label class="form-check-label small" for="col-<%= key %>"><%= label %></label></div>
                <% end %>
              </div>
            </div>
          </div>
          <%= render 'admin/etd_reports/buttons', kind: 'custom' %>
        <% end %>
      </div></div>
    </div>
  </div>
</div>
