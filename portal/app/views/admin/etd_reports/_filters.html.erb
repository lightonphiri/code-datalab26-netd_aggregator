<%# Filters shared by the three report forms (FR-63) %>
<div class="row g-2">
  <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.institution') %>
    <%= select_tag :institution, options_for_select([[nt('admin.reports.all_institutions'), '']] + @institutions.map { |i| [i[:name], i[:source]] }),
                   class: 'form-select form-select-sm' %></label></div>
  <div class="col-md-3"><label class="form-label small"><%= nt('admin.reports.year_from') %>
    <%= number_field_tag :year_from, nil, min: 1960, max: Date.current.year, class: 'form-control form-control-sm' %></label></div>
  <div class="col-md-3"><label class="form-label small"><%= nt('admin.reports.year_to') %>
    <%= number_field_tag :year_to, nil, min: 1960, max: Date.current.year, class: 'form-control form-control-sm' %></label></div>
  <% if local_assigns[:more] %>
    <div class="col-md-4"><label class="form-label small"><%= nt('admin.reports.degree_level') %>
      <%= select_tag :degree_level, options_for_select([[nt('admin.reports.any'), '']] + @values['degree_level_ssim']), class: 'form-select form-select-sm' %></label></div>
    <div class="col-md-4"><label class="form-label small"><%= nt('admin.reports.type') %>
      <%= select_tag :type, options_for_select([[nt('admin.reports.any'), '']] + @values['type_ssim']), class: 'form-select form-select-sm' %></label></div>
    <div class="col-md-4"><label class="form-label small"><%= nt('admin.reports.field_of_study') %>
      <%= select_tag :fos_field, options_for_select([[nt('admin.reports.any'), '']] + @values['fos_field_ssim']), class: 'form-select form-select-sm' %></label></div>
  <% end %>
  <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.faculty') %>
    <%= select_tag :faculty, options_for_select([[nt('admin.reports.any'), '']] + @values['faculty_ssim']), class: 'form-select form-select-sm' %></label></div>
  <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.department') %>
    <%= text_field_tag :department, nil, list: "netd-departments-#{local_assigns[:id]}", class: 'form-control form-control-sm', autocomplete: 'off' %></label>
    <datalist id="netd-departments-<%= local_assigns[:id] %>"><% @values['department_ssim'].each do |d| %><option value="<%= d %>"></option><% end %></datalist></div>
  <% if local_assigns[:more] %>
    <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.supervisor') %>
      <%= text_field_tag :supervisor, nil, class: 'form-control form-control-sm', placeholder: nt('admin.reports.supervisor_example') %></label></div>
    <div class="col-md-6"><label class="form-label small"><%= nt('admin.reports.words') %>
      <%= text_field_tag :words, nil, class: 'form-control form-control-sm' %></label></div>
  <% end %>
  <div class="col-12"><div class="form-check"><%= check_box_tag :cited, '1', false, class: 'form-check-input', id: "cited-#{local_assigns[:id]}" %>
    <label class="form-check-label small" for="cited-<%= local_assigns[:id] %>"><%= nt('admin.reports.cited_html') %></label></div></div>
</div>
