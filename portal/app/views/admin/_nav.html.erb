<nav class="netd-admin-nav">
  <strong>Admin</strong>
  <%= link_to 'Dashboard', admin_root_path %>
  <%= link_to 'Problem reports', admin_problem_reports_path %>
  <%= link_to 'Upload CSV', new_admin_csv_upload_path %>
  <%= link_to 'Activity log', admin_events_path %>
  <span class="netd-admin-user"><%= current_admin.name %> ·
    <%= link_to 'Change password', edit_admin_password_path %> ·
    <%= button_to 'Sign out', admin_sign_out_path, method: :delete, form_class: 'd-inline', class: 'btn btn-link p-0 align-baseline' %></span>
</nav>
<% flash.each do |type, msg| %>
  <div class="alert alert-<%= type.to_s == 'alert' ? 'danger' : 'success' %>"><%= msg %></div>
<% end %>
