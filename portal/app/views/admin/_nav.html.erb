<nav class="netd-admin-nav">
  <strong><%= nt('admin.nav.admin_html') %></strong>
  <% if current_admin.admin? %>
    <%= link_to nt('admin.nav.dashboard'), admin_root_path %>
    <%= link_to nt('admin.nav.problem_reports'), admin_problem_reports_path %>
    <%= link_to nt('admin.nav.upload_csv'), new_admin_csv_upload_path %>
    <% rc = Harvester.review_count %>
    <%= link_to "#{nt('admin.nav.level_review')}#{" (#{rc})" if rc.positive?}", admin_reviews_path %>
    <%= link_to nt('admin.nav.duplicates', n: Harvester.duplicate_count), admin_duplicates_path %>
    <%= link_to nt('admin.nav.activity_log'), admin_events_path %>
    <%= form_with url: admin_record_lookup_path, method: :get, local: true, class: 'netd-admin-lookup d-inline' do %>
      <%= text_field_tag :id, nil, placeholder: nt('admin.nav.lookup_placeholder'), 'aria-label': nt('admin.nav.lookup_label'), size: 22 %>
      <%= submit_tag nt('admin.nav.correct'), class: 'btn btn-sm btn-outline-secondary', name: nil %>
    <% end %>
  <% end %>
  <%= link_to nt('admin.nav.quality'), admin_quality_path %>
  <%= link_to nt('admin.nav.usage'), admin_usage_path %>
  <%= link_to nt('admin.nav.etd_reports'), admin_etd_reports_path %>
  <span class="netd-admin-user"><%= current_admin.name %> ·
    <%= link_to nt('admin.nav.change_password'), edit_admin_password_path %> ·
    <%= button_to nt('admin.nav.sign_out'), admin_sign_out_path, method: :delete, form_class: 'd-inline', class: 'btn btn-link p-0 align-baseline' %></span>
</nav>
<% flash.each do |type, msg| %>
  <div class="alert alert-<%= type.to_s == 'alert' ? 'danger' : 'success' %>"><%= msg %></div>
<% end %>
