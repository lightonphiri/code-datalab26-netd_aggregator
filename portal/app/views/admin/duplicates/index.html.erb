<% content_for(:page_title) { nt('admin.duplicates.page_title') } %>
<div class="netd-admin">
  <%= render 'admin/nav' %>
  <h1><%= nt('admin.duplicates.heading_html') %></h1>
  <p class="netd-admin-help"><%= nt('admin.duplicates.help_html') %></p>
  <% if @running %><p class="alert alert-warning"><%= nt('admin.duplicates.running_html') %></p><% end %>
  <p><%= nt('admin.duplicates.counts_html', groups: @groups.size, copies: @groups.sum { |g| g['copies'].size }) %></p>
  <table class="table table-sm netd-admin-table">
    <thead><tr><th><%= nt('admin.duplicates.record_html') %></th><th><%= nt('admin.duplicates.title_html') %></th><th><%= nt('admin.duplicates.author_html') %></th><th><%= nt('admin.duplicates.year_html') %></th><th><%= nt('admin.duplicates.match_html') %></th><th></th></tr></thead>
    <tbody>
    <% @groups.each do |g| %>
      <% m = g['primary'] %>
      <tr class="table-light">
        <td><%= link_to m['id'], solr_document_path(ThesisId.short(m['id'])) %><br><small><%= nt('admin.duplicates.main_html') %><%= nt('admin.duplicates.with_pdf') if m['pdf'] %></small></td>
        <td><%= m['title'] %></td><td><%= m['author'] %></td><td><%= m['year'] %></td><td></td>
        <td class="text-nowrap"><%= button_to nt('admin.duplicates.not_duplicate'), admin_decide_duplicate_path(m['id']), params: { decision: 'distinct' }, class: 'btn btn-sm btn-outline-secondary', form_class: 'd-inline' %></td>
      </tr>
      <% g['copies'].each do |c| %>
        <tr>
          <td><%= link_to c['id'], solr_document_path(ThesisId.short(c['id'])) %><br><small><%= nt('admin.duplicates.copy_html') %><%= nt('admin.duplicates.with_pdf') if c['pdf'] %></small></td>
          <td><%= c['title'] %></td><td><%= c['author'] %></td><td><%= c['year'] %></td>
          <td><small><%= c['method'] %><%= format(' %.2f', c['score'].to_f) if c['score'] %></small></td>
          <td class="text-nowrap">
            <%= button_to nt('admin.duplicates.make_main'), admin_decide_duplicate_path(c['id']), params: { decision: 'primary' }, class: 'btn btn-sm btn-outline-primary', form_class: 'd-inline' %>
            <%= button_to nt('admin.duplicates.not_duplicate'), admin_decide_duplicate_path(c['id']), params: { decision: 'distinct' }, class: 'btn btn-sm btn-outline-secondary', form_class: 'd-inline' %>
          </td>
        </tr>
      <% end %>
    <% end %>
    <% if @groups.empty? %><tr><td colspan="6"><%= nt('admin.duplicates.none_html') %></td></tr><% end %>
    </tbody>
  </table>
  <h2 class="h5 mt-4"><%= nt('admin.duplicates.decisions_html') %></h2>
  <table class="table table-sm netd-admin-table">
    <thead><tr><th><%= nt('admin.duplicates.record_html') %></th><th><%= nt('admin.duplicates.title_html') %></th><th><%= nt('admin.duplicates.decision_html') %></th><th><%= nt('admin.duplicates.by_html') %></th><th><%= nt('admin.duplicates.when_html') %></th><th></th></tr></thead>
    <tbody>
    <% @decided.each do |c| %>
      <tr>
        <td><%= link_to c['record_id'], admin_record_path(c['record_id']) %></td>
        <td><%= c['title'] %></td>
        <td><%= (JSON.parse(c['value']).first rescue c['value']) == 'distinct' ? nt('admin.duplicates.not_duplicate') : nt('admin.duplicates.main_record') %></td>
        <td><%= c['made_by'] %></td>
        <td><%= l(Time.at(c['created_at'].to_f).utc, format: :netd_utc) %></td>
        <td><%= button_to nt('admin.remove_decision'), admin_uncorrect_record_path(c['record_id'], '_duplicate'), method: :delete, class: 'btn btn-link btn-sm p-0' %></td>
      </tr>
    <% end %>
    <% if @decided.empty? %><tr><td colspan="6"><%= nt('admin.duplicates.no_decisions_html') %></td></tr><% end %>
    </tbody>
  </table>
</div>
