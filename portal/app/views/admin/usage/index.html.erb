<% content_for(:page_title) { nt('admin.usage.page_title') } %>
<% labels = UsageCount::EVENTS %>
<div class="netd-admin netd-usage">
  <%= render 'admin/nav' %>
  <h1><%= nt('admin.usage.heading_html') %></h1>
  <p class="netd-admin-help"><%= nt('admin.usage.intro_html') %>
    <% if @first_day %><%= nt('admin.usage.since_html', date: l(@first_day, format: :netd)) %><% end %></p>
  <p><%= nt('admin.usage.period_html') %>
    <% Admin::UsageController::PERIODS.each do |n| %>
      <% if n == @days %><strong><%= nt('admin.usage.last_days', n: n) %></strong><% else %><%= link_to nt('admin.usage.last_days', n: n), admin_usage_path(days: n) %><% end %> ·
    <% end %>
    <%= nt('admin.usage.csv_html') %> <%= link_to nt('admin.usage.csv_events'), admin_usage_path(days: @days, format: :csv) %> ·
    <%= link_to nt('admin.usage.csv_places'), admin_usage_path(days: @days, format: :csv, table: 'places') %> ·
    <%= link_to nt('admin.usage.csv_facets'), admin_usage_path(days: @days, format: :csv, table: 'facets') %></p>

  <% if @totals.empty? %>
    <p><%= nt('admin.usage.nothing_html') %></p>
  <% else %>
    <h2><%= nt('admin.usage.totals_html') %></h2>
    <table class="table table-sm netd-admin-table w-auto">
      <tbody>
      <% labels.each do |ev, label| %>
        <tr><td><%= usage_icon(:view) if ev == 'record_view' %><%= usage_icon(:download) if ev == 'pdf_download' %> <%= label %></td><td class="text-end"><strong><%= number_with_delimiter(@totals[ev].to_i) %></strong></td></tr>
      <% end %>
      </tbody>
    </table>

    <h2><%= nt('admin.usage.by_day_html') %></h2>
    <% peak = [@dates.map { |d| @daily[[d, 'record_view']].to_i }.max.to_i, 1].max %>
    <div class="table-responsive" style="max-height: 28rem">
    <table class="table table-sm netd-admin-table">
      <thead><tr><th><%= nt('admin.usage.day_html') %></th><% labels.each_key do |ev| %><th class="text-end"><%= labels[ev].split(' (').first %></th><% end %><th><%= usage_icon(:view) %> <%= nt('admin.usage.record_views_html') %></th></tr></thead>
      <tbody>
      <% @dates.reverse_each do |d| %>
        <% rv = @daily[[d, 'record_view']].to_i %>
        <tr><td><%= l(d, format: :netd) %></td>
          <% labels.each_key do |ev| %><td class="text-end"><%= number_with_delimiter(@daily[[d, ev]].to_i) %></td><% end %>
          <td style="min-width: 10rem"><span style="display:inline-block;height:.7rem;background:#0071c2;width:<%= (100.0 * rv / peak).round(1) %>%" aria-hidden="true"></span></td></tr>
      <% end %>
      </tbody>
    </table>
    </div>

    <h2><%= nt('admin.usage.by_institution_html') %></h2>
    <% insts = @by_inst.keys.map(&:first).uniq.sort_by { |i| -@by_inst[[i, 'record_view']].to_i } %>
    <table class="table table-sm netd-admin-table w-auto">
      <thead><tr><th><%= nt('admin.usage.institution_html') %></th><th class="text-end"><%= usage_icon(:view) %> <%= nt('admin.usage.record_views_html') %></th><th class="text-end"><%= usage_icon(:download) %> <%= nt('admin.usage.pdf_downloads_html') %></th></tr></thead>
      <tbody>
      <% insts.each do |i| %>
        <tr><td><%= i.presence || nt('admin.usage.unknown') %></td><td class="text-end"><%= number_with_delimiter(@by_inst[[i, 'record_view']].to_i) %></td>
          <td class="text-end"><%= number_with_delimiter(@by_inst[[i, 'pdf_download']].to_i) %></td></tr>
      <% end %>
      </tbody>
    </table>

    <div class="row">
      <% [[:view, nt('admin.usage.most_viewed'), @top_views], [:download, nt('admin.usage.most_downloaded'), @top_pdfs]].each do |icon, heading, rows| %>
        <div class="col-lg-6">
          <h2><%= usage_icon(icon, size: 20) %> <%= heading %></h2>
          <% if rows.empty? %><p><%= nt('admin.none_yet_html') %></p><% else %>
          <ol class="small">
            <% rows.each do |id, n| %>
              <li><%= link_to(@titles[id] || id, solr_document_path(ThesisId.short(id))) %> · <%= number_with_delimiter(n) %></li>
            <% end %>
          </ol>
          <% end %>
        </div>
      <% end %>
    </div>

    <h2><%= nt('admin.usage.where_html') %></h2>
    <p class="netd-admin-help"><%= nt('admin.usage.places_help_html') %>
      <% unless @geo_ready %><strong><%= nt('admin.usage.no_geo_html') %></strong><% end %></p>
    <% if @countries.empty? %><p><%= nt('admin.usage.none_period_html') %></p><% else %>
    <div class="row">
      <div class="col-lg-6">
        <% names = @countries.keys.map(&:first).uniq.sort_by { |c| -@countries[[c, 'record_view']].to_i } %>
        <table class="table table-sm netd-admin-table w-auto">
          <thead><tr><th><%= nt('admin.usage.country_html') %></th><th class="text-end"><%= usage_icon(:view) %> <%= nt('admin.usage.record_views_html') %></th><th class="text-end"><%= usage_icon(:download) %> <%= nt('admin.usage.pdf_downloads_html') %></th><th class="text-end"><%= nt('admin.usage.searches_html') %></th></tr></thead>
          <tbody>
          <% names.each do |c| %>
            <tr><td><%= c.presence || nt('admin.usage.unknown') %></td>
              <% %w[record_view pdf_download search].each do |ev| %><td class="text-end"><%= number_with_delimiter(@countries[[c, ev]].to_i) %></td><% end %></tr>
          <% end %>
          </tbody>
        </table>
      </div>
      <div class="col-lg-6">
        <table class="table table-sm netd-admin-table w-auto">
          <thead><tr><th><%= nt('admin.usage.city_html') %></th><th><%= nt('admin.usage.country_html') %></th><th class="text-end"><%= nt('admin.usage.views_downloads_searches_html') %></th></tr></thead>
          <tbody>
          <% @cities.each do |(city, country), n| %>
            <tr><td><%= city %></td><td><%= country %></td><td class="text-end"><%= number_with_delimiter(n) %></td></tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% end %>

    <h2><%= nt('admin.usage.popular_html') %></h2>
    <p class="netd-admin-help"><%= nt('admin.usage.popular_help_html') %></p>
    <% if @facets.empty? %><p><%= nt('admin.usage.none_period_html') %></p><% else %>
    <div class="row">
      <% @facets.sort.each do |label, rows| %>
        <div class="col-md-6 col-xl-4">
          <h3 class="h6"><%= label %></h3>
          <ol class="small">
            <% rows.each do |(_, value), n| %><li><%= value %> · <%= number_with_delimiter(n) %></li><% end %>
          </ol>
        </div>
      <% end %>
    </div>
    <% end %>

    <h2><%= nt('admin.usage.api_oai_html') %></h2>
    <% if @endpoints.empty? %><p><%= nt('admin.usage.none_period_html') %></p><% else %>
    <table class="table table-sm netd-admin-table w-auto">
      <thead><tr><th><%= nt('admin.usage.interface_html') %></th><th><%= nt('admin.usage.endpoint_html') %></th><th class="text-end"><%= nt('admin.usage.requests_html') %></th></tr></thead>
      <tbody>
      <% @endpoints.each do |(ev, key), n| %>
        <tr><td><%= ev == 'api' ? 'API v1' : 'OAI-PMH' %></td><td><code><%= key.presence || nt('admin.usage.none_key') %></code></td><td class="text-end"><%= number_with_delimiter(n) %></td></tr>
      <% end %>
      </tbody>
    </table>
    <% end %>
  <% end %>
</div>
