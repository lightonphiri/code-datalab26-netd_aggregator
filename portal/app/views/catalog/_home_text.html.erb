<%# Landing page in the style of Columbia's Academic Commons: one-line intro, two explore cards,
    stats at a glance, contributing institutions (all postgraduate institutions accredited by the regulator, 0 where none). %>
<% agg = ->(f) { (@response&.aggregations&.dig(f)&.items || []).to_h { |i| [i.value, i.hits] } } %>
<% inst = agg.call('institution_ssim'); lvl = agg.call('degree_level_ssim'); ft = agg.call('full_text_ssim') %>
<% years = agg.call('year_ssim').keys.map(&:to_i).select(&:positive?) %>
<% total = @response&.total || 0 %>
<% registry = InstitutionRegistry.all %>
<% contributing = registry.select { |i| inst[i[:name]].to_i.positive? }.sort_by { |i| -inst[i[:name]] } %>
<% waiting = registry - contributing %>
<% fmt = ->(n) { number_with_delimiter(n.to_i) } %>
<div class="netd-home">
  <p class="netd-intro"><%= nt('home.intro_html') %>
    <%= link_to nt('home.learn_more'), about_path %></p>

  <div class="row g-4 netd-cards">
    <div class="col-md-6">
      <%= link_to search_action_path(f: { degree_level_ssim: ['Masters'] }), class: 'netd-card' do %>
        <span class="netd-card-title"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 5h11M4 9h11M4 13h7"/><circle cx="16" cy="15" r="3.5"/><path d="m18.6 17.6 2.4 2.4"/></svg>
          <%= nt('home.masters_title_html') %></span>
        <span class="netd-card-text"><%= nt('home.masters_text_html', n: fmt.(lvl['Masters'])) %></span>
      <% end %>
    </div>
    <div class="col-md-6">
      <%= link_to search_action_path(f: { degree_level_ssim: ['Doctoral'] }), class: 'netd-card' do %>
        <span class="netd-card-title"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/><path d="M22 9v6"/></svg>
          <%= nt('home.doctoral_title_html') %></span>
        <span class="netd-card-text"><%= nt('home.doctoral_text_html', n: fmt.(lvl['Doctoral'])) %></span>
      <% end %>
    </div>
  </div>

  <div class="row g-5 mt-1">
    <div class="col-lg-4">
      <h2 class="netd-kicker"><%= nt('home.stats_html') %></h2>
      <table class="netd-stats">
        <tr><td><%= fmt.(total) %></td><td><%= link_to nt('home.stat_total'), search_action_path(q: '', search_field: 'all_fields') %></td></tr>
        <tr><td><%= fmt.(lvl['Masters']) %></td><td><%= link_to nt('home.stat_masters'), search_action_path(f: { degree_level_ssim: ['Masters'] }) %></td></tr>
        <tr><td><%= fmt.(lvl['Doctoral']) %></td><td><%= link_to nt('home.stat_doctoral'), search_action_path(f: { degree_level_ssim: ['Doctoral'] }) %></td></tr>
        <tr><td><%= fmt.(ft['PDF available']) %></td><td><%= link_to nt('home.stat_pdf'), search_action_path(f: { full_text_ssim: ['PDF available'] }) %></td></tr>
        <tr><td><%= nt('home.stat_institutions_count_html', n: contributing.size, total: registry.size) %></td><td><%= nt('home.stat_institutions_html') %></td></tr>
        <% if years.any? %><tr><td><%= years.min %>–<%= years.max %></td><td><%= nt('home.stat_years_html') %></td></tr><% end %>
      </table>
      <p class="netd-note"><%= nt('home.no_level_html', n: fmt.(total - lvl.values.sum)) %></p>
      <p class="netd-note"><%= link_to nt('home.newest'), search_action_path(sort: 'added') %> ·
        <%= link_to follow_path, title: nt('home.follow_title') do %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.2"/></svg> <%= nt('home.follow_html') %><% end %></p>
    </div>
    <div class="col-lg-8">
      <h2 class="netd-kicker"><%= nt('home.contributing_html') %></h2>
      <ul class="netd-inst">
        <% contributing.each do |i| %>
          <li><%= link_to i[:name], search_action_path(f: { institution_ssim: [i[:name]] }) %><span><%= fmt.(inst[i[:name]]) %></span></li>
        <% end %>
      </ul>
      <p class="netd-note"><%= nt('home.harvest_note_html', n: registry.size, regulator_link: regulator_link) %>
        <a class="netd-more-toggle collapsed" data-bs-toggle="collapse" href="#netd-waiting" role="button" aria-expanded="false" aria-controls="netd-waiting">
          <span class="when-collapsed"><%= nt('home.show_waiting_html', n: waiting.size) %></span><span class="when-expanded"><%= nt('home.hide_waiting_html') %></span></a></p>
      <ul class="netd-inst netd-inst-waiting collapse" id="netd-waiting">
        <% waiting.sort_by { |i| i[:name] }.each do |i| %>
          <li><span><%= i[:name] %><small><%= InstitutionRegistry::STATUS_LABELS[i[:status]] %></small></span><span>0</span></li>
        <% end %>
      </ul>
      <p class="netd-note"><%= nt('home.listed_zero_html', link: link_to(nt('home.listed_zero_link'), contribute_path)) %></p>
    </div>
  </div>
</div>
