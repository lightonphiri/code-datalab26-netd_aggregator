[Unit]
Description=NETD weekly status email
OnFailure=netd-alert@%n.service

[Service]
Type=oneshot
# Check the repositories of institutions not yet harvested (FR-58); a failure here never stops the email
ExecStartPre=-/usr/sbin/runuser -u netd -- /bin/sh -c 'cd /opt/netd/harvester && .venv/bin/python -m netd.cli check-repositories'
TimeoutStartSec=1800
ExecStart=/usr/bin/python3 /opt/netd/deploy/ops/netd-alert.py --weekly
